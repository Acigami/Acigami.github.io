---
import type { CollectionEntry } from 'astro:content';
import { formatearFecha } from '../fechas';

interface Props {
  proyecto: CollectionEntry<'proyectos'>;
}

const { proyecto } = Astro.props;
const { titulo, descripcion, fecha, etiquetas, borrador } = proyecto.data;
const fechaLegible = formatearFecha(fecha);
---

<article class="fila">
  <h3>
    <a href={`/proyectos/${proyecto.id}/`}>{titulo}</a>
    {borrador && <span class="insignia-borrador">borrador</span>}
  </h3>
  <p class="meta">
    {fechaLegible}{etiquetas.length > 0 && ` · ${etiquetas.join(', ')}`}
  </p>
  <p>{descripcion}</p>
</article>
