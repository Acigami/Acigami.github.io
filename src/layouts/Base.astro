---
import '@fontsource-variable/source-serif-4';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PerfilLateral from '../components/PerfilLateral.astro';
import { DESCRIPCION } from '../consts';

interface Props {
  titulo: string;
  descripcion?: string;
  perfil?: 'completo' | 'compacto';
}

const { titulo, descripcion = DESCRIPCION, perfil = 'compacto' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={descripcion} />
    <meta name="generator" content={Astro.generator} />
    <title>{titulo}</title>
    <script is:inline>
      // Aplica el tema guardado antes del primer pintado para evitar el flash.
      const tema = localStorage.getItem('tema');
      if (tema === 'claro' || tema === 'oscuro') document.documentElement.dataset.tema = tema;
    </script>
  </head>
  <body>
    <Header />
    <main>
      <PerfilLateral variante={perfil} />
      <div class="contenido">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>

<style>
  .contenido {
    flex: 1;
    min-width: 0;
  }
</style>
