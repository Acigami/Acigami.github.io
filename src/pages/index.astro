---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TarjetaProyecto from '../components/TarjetaProyecto.astro';
import { ENLACES, NOMBRE } from '../consts';

const destacados = (await getCollection('proyectos', ({ data }) => data.destacado)).sort(
  (a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf()
);
---

<Base titulo={NOMBRE}>
  <section class="hero">
    <h1>{NOMBRE}</h1>
    <p class="bajada">
      Vengo de la antropología y me dedico a los datos: doy clases de aprendizaje automático en
      la UNSAM y en GeoDojo, y estoy terminando la tesina de la licenciatura. Acá junto mis
      proyectos y un sandbox de experimentos que corren en el navegador.
    </p>
    <p><a href="/sobre-mi/">Más sobre mí</a></p>
    <ul class="hub">
      {
        ENLACES.map((enlace) => (
          <li>
            <a href={enlace.href}>{enlace.texto}</a>
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <h2>Proyectos destacados</h2>
    <div class="lista-tarjetas">
      {destacados.map((proyecto) => <TarjetaProyecto proyecto={proyecto} />)}
    </div>
    <p><a href="/proyectos/">Todos los proyectos</a></p>
  </section>

  <section>
    <h2>Sandbox</h2>
    <p>
      Experimentos que corren en el navegador. El primero:
      <a href="/sandbox/regresion-lineal/">un juguete de regresión lineal</a> para agregar puntos
      a mano y ver cómo se ajusta la recta.
    </p>
    <p><a href="/sandbox/">Todo el sandbox</a></p>
  </section>
</Base>

<style>
  .hero {
    margin-bottom: 2.5rem;
  }

  .hero h1 {
    font-size: 2.25rem;
    margin: 0 0 0.5rem;
  }

  .bajada {
    font-size: 1.15rem;
    color: var(--texto-suave);
    margin: 0 0 0.75rem;
  }

  .hub {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  .hub a {
    display: inline-block;
    border: 1px solid var(--borde);
    border-radius: 999px;
    padding: 0.25rem 0.9rem;
    font-size: 0.9rem;
    color: var(--texto);
    text-decoration: none;
    background: var(--fondo-suave);
  }

  .hub a:hover {
    border-color: var(--acento);
    color: var(--acento);
  }
</style>
