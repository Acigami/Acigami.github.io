---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TarjetaProyecto from '../components/TarjetaProyecto.astro';
import { NOMBRE } from '../consts';

const destacados = (await getCollection('proyectos', ({ data }) => data.destacado)).sort(
  (a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf()
);
---

<Base titulo={NOMBRE} perfil="completo">
  <section>
    <h2 class="titulo-seccion primero">Proyectos destacados</h2>
    <div class="lista-filas">
      {destacados.map((proyecto) => <TarjetaProyecto proyecto={proyecto} />)}
    </div>
    <p><a href="/proyectos/">Todos los proyectos</a></p>
  </section>

  <section>
    <h2 class="titulo-seccion">Sandbox</h2>
    <p>
      Experimentos que corren en el navegador. El último:
      <a href="/sandbox/mapa-topicos-eu/">un mapa de discursos del Parlamento Europeo</a> agrupados
      por tópico, para recorrer con zoom y leer fragmentos.
    </p>
    <p><a href="/sandbox/">Todo el sandbox</a></p>
  </section>
</Base>
